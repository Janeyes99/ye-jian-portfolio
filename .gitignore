!assets/portfolio/
assets/portfolio/**
!assets/portfolio/**/
!assets/portfolio/**/*.gif
!assets/portfolio/**/*.jpg
!assets/portfolio/**/*.jpeg
!assets/portfolio/**/*.png
!assets/portfolio/**/*.svg
!assets/portfolio/**/*.webp
!assets/portfolio/path/touch-hold-color.mp4
!assets/portfolio/path/touch-click-color.mp4
!assets/portfolio/memory-parking/memory-parking-promo-zh.mp4

